# ==============================================
# StreamCopilot Root Environment Configuration
# ==============================================

# Backend Server Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# LLM Provider: "development" or "openai"
# Use "development" for local testing, CI, and zero-cost reproducible demos
LLM_PROVIDER=development

# OpenAI-Compatible Provider Settings (Only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Development Provider Token Pacing (milliseconds per token)
DEV_TOKEN_DELAY_MS=25

# Frontend Configuration
VITE_API_BASE_URL=
